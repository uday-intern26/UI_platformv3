# AIJewel Local Environment Template
# Copy to .env at repo root. Never commit secrets.

AIJEWEL_ENV=local
AIJEWEL_JWT_SECRET=local-dev-jwt-secret-change-me
AIJEWEL_JWT_ISSUER=aijewel-local
AIJEWEL_JWT_AUDIENCE=aijewel-api

DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
STORAGE_ROOT=./data/storage
CHROMA_PATH=./data/chroma
EVENT_BUS_URL=http://127.0.0.1:8090

# Service URLs (local)
DASHBOARD_BFF_URL=http://127.0.0.1:3001
CUSTOMER_ONBOARDING_URL=http://127.0.0.1:5003
MODEL_GATEWAY_URL=http://127.0.0.1:8101
ORGANIZATION_SERVICE_URL=http://127.0.0.1:5001
IDENTITY_ACCESS_URL=http://127.0.0.1:5002

# AI providers — mock by default
MODEL_GATEWAY_PROVIDER=mock
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
