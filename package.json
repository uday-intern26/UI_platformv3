{
  "name": "aijewel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AIJewel Enterprise AI Platform monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "contracts:lint": "node scripts/contracts-lint.mjs",
    "contracts:generate": "node scripts/contracts-generate.mjs",
    "dev:bff": "pnpm --filter @aijewel/dashboard-bff dev",
    "dev:onboarding": "pnpm --filter @aijewel/customer-onboarding dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "yaml": "^2.6.1",
    "openapi-typescript": "^7.4.4",
    "@aijewel/shared-node": "workspace:*"
  }
}
